<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.5.2</Version>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- x64 by default; publish with -r win-arm64 for Snapdragon PCs (tools/publish-release.ps1 builds both). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU'">x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\DynamicIsland\Assets\island.ico</ApplicationIcon>
    <AssemblyName>DynamicIsland.Settings</AssemblyName>
    <RootNamespace>DynamicIsland.SettingsApp</RootNamespace>

    <!-- Plain .exe, no MSIX: the Windows App SDK runtime is copied next to it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <!-- The Windows App SDK runtime copied next to the app includes on-device AI (ONNX Runtime, DirectML): about
       45 MB this app never uses. They're only loaded when an AI API is called, so the published app leaves them out. -->
  <Target Name="RemoveUnusedRuntimeParts" AfterTargets="Publish">
    <ItemGroup>
      <UnusedRuntimePart Include="$(PublishDir)onnxruntime*.dll;$(PublishDir)DirectML.dll;$(PublishDir)Microsoft.ML.OnnxRuntime.dll;$(PublishDir)Microsoft.Windows.AI.MachineLearning.dll;$(PublishDir)NpuDetect\**" />
    </ItemGroup>
    <Delete Files="@(UnusedRuntimePart)" />
    <RemoveDir Directories="$(PublishDir)NpuDetect" />
  </Target>

  <!-- The settings model is shared with the island so both read and write the same settings.json. -->
  <ItemGroup>
    <Compile Include="..\DynamicIsland\Settings\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\DynamicIsland\Settings\IslandStatus.cs" Link="Shared\IslandStatus.cs" />
    <Compile Include="..\DynamicIsland\Settings\Displays.cs" Link="Shared\Displays.cs" />
    <Compile Include="..\DynamicIsland\Settings\IslandTheme.cs" Link="Shared\IslandTheme.cs" />
    <Compile Include="..\DynamicIsland\Settings\IslandMessages.cs" Link="Shared\IslandMessages.cs" />
    <Compile Include="..\DynamicIsland\Settings\CrashReport.cs" Link="Shared\CrashReport.cs" />
    <Compile Include="..\DynamicIsland\Settings\L.cs" Link="Shared\L.cs" />
    <Compile Include="..\DynamicIsland\Settings\Strings.nl.cs" Link="Shared\Strings.nl.cs" />
    <Compile Include="..\DynamicIsland\Settings\Strings.de.cs" Link="Shared\Strings.de.cs" />
    <Compile Include="..\DynamicIsland\Settings\Strings.fr.cs" Link="Shared\Strings.fr.cs" />
    <Compile Include="..\DynamicIsland\Core\Log.cs" Link="Shared\Log.cs" />
    <Compile Include="..\DynamicIsland\Updates\UpdateChecker.cs" Link="Shared\UpdateChecker.cs" />
    <Content Include="..\DynamicIsland\Assets\island.ico" Link="Assets\island.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
