<Page x:Class="DynamicIsland.SettingsApp.Pages.AddonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The cards are built in code from one list (see AddonsPage.xaml.cs), so every add-on looks the same. -->
    <ScrollViewer>
        <StackPanel x:Name="Root" Style="{StaticResource PageStack}">
            <TextBlock Text="Add-ons" Style="{StaticResource PageTitle}" Margin="0,28,0,4" />
            <TextBlock Text="Extra things the island can show. Changes apply right away."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
        </StackPanel>
    </ScrollViewer>
</Page>
