<Page x:Class="DynamicIsland.SettingsApp.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />

            <tk:SettingsCard Header="Dynamic Island for Windows" x:Name="VersionCard">
                <tk:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/island.ico" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="StartButton" Content="Start island" Click="OnStart" />
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />

            <tk:SettingsCard x:Name="UpdateCard" Header="Check for updates" Description="Updates come from the releases on GitHub.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="Checking" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="CheckButton" Content="Check now" Click="OnCheck" />
                </StackPanel>
            </tk:SettingsCard>

            <InfoBar x:Name="UpdateBar" IsClosable="False" Severity="Informational">
                <InfoBar.Content>
                    <StackPanel Spacing="8" Margin="0,0,0,12">
                        <TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" MaxHeight="160" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Maximum="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InstallButton" Content="Download and install" Style="{StaticResource AccentButtonStyle}" Click="OnInstall" />
                            <HyperlinkButton x:Name="NotesLink" Content="Release notes" />
                        </StackPanel>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <tk:SettingsCard Header="Check automatically" Description="The island lets you know when a new version is out.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutoCheck" Toggled="OnAutoCheck" />
            </tk:SettingsCard>

            <TextBlock Text="Files" Style="{StaticResource SectionHeader}" />

            <tk:SettingsCard Header="Settings file" x:Name="SettingsFileCard" IsClickEnabled="True" Click="OnOpenSettingsFile">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Logs" Description="Look here if something isn't working." IsClickEnabled="True" Click="OnOpenLogs">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9F9;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
