<Page x:Class="DynamicIsland.SettingsApp.Pages.MediaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="Music" Style="{StaticResource PageTitle}" />

            <tk:SettingsCard Header="Show what's playing" Description="Album art, live audio bars and playback controls. The island restarts to apply this.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D6;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="MediaEnabled" Toggled="OnMediaEnabled" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="AnyPlayerCard" Header="Show any media player" Description="Off: only Spotify. On: browsers, Apple Music and anything else that uses Windows media controls.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE93C;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AnyPlayer" Toggled="OnAnyPlayer" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="HideAfterCard" Header="Hide after pausing" Description="Seconds the music stays in the island after you pause.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </tk:SettingsCard.HeaderIcon>
                <NumberBox x:Name="HideAfter" Minimum="1" Maximum="600" SmallChange="1" LargeChange="10"
                           SpinButtonPlacementMode="Inline" MinWidth="140" ValueChanged="OnHideAfter" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
