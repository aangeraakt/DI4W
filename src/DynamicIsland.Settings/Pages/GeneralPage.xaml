<Page x:Class="DynamicIsland.SettingsApp.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />

            <InfoBar x:Name="NotRunning" Severity="Warning" IsClosable="False"
                     Title="The island isn't running" Message="Changes are saved and apply the next time it starts.">
                <InfoBar.ActionButton>
                    <Button Content="Start island" Click="OnStartIsland" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" />

            <tk:SettingsCard x:Name="AutostartCard" Header="Start with Windows" Description="Open the island when you sign in.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutostartToggle" Toggled="OnAutostart" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Hide in fullscreen apps" Description="Get out of the way while a game, video or presentation fills the screen. Screenshots never hide it.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE740;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="HideInFullscreen" Toggled="OnHideInFullscreen" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Sounds" Description="Chimes for alerts and the timer alarm.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Sounds" Toggled="OnSounds" />
            </tk:SettingsCard>

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />

            <tk:SettingsCard Header="Size" Description="How big the island is.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71E;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="SizeBox" MinWidth="160" SelectionChanged="OnSize">
                    <ComboBoxItem Content="Small" Tag="0.85" />
                    <ComboBoxItem Content="Normal" Tag="1.0" />
                    <ComboBoxItem Content="Large" Tag="1.2" />
                    <ComboBoxItem Content="Extra large" Tag="1.4" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Distance from top" Description="Space between the top of the screen and the island.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE76F;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="TopOffset" Width="200" Minimum="0" Maximum="40" StepFrequency="1"
                            ValueChanged="OnTopOffset" VerticalAlignment="Center" />
                    <TextBlock x:Name="TopOffsetLabel" MinWidth="36" VerticalAlignment="Center" />
                </StackPanel>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
