<Page x:Class="DynamicIsland.SettingsApp.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls"
      xmlns:controls="using:DynamicIsland.SettingsApp.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />

            <InfoBar x:Name="NotRunning" Severity="Warning" IsClosable="False"
                     Title="The island isn't running" Message="Changes are saved and apply the next time it starts.">
                <InfoBar.ActionButton>
                    <Button Content="Start island" Click="OnStartIsland" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" />

            <tk:SettingsCard x:Name="AutostartCard" Header="Start with Windows" Description="Open the island when you sign in.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutostartToggle" Toggled="OnAutostart" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Hide in fullscreen apps" Description="Get out of the way while a game, video or presentation fills the screen. Screenshots never hide it.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE740;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="HideInFullscreen" Toggled="OnHideInFullscreen" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Sounds" Description="Chimes for alerts and the timer alarm.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="Sounds" Toggled="OnSounds" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Hide island shortcut" Description="Press this anywhere to hide the island, and again to bring it back.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </tk:SettingsCard.HeaderIcon>
                <controls:ShortcutBox x:Name="HideShortcut" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Open island shortcut"
                             Description="Opens what the island shows (or the timer picker) without the mouse; screen readers read it out. Press again to close.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.HeaderIcon>
                <controls:ShortcutBox x:Name="ExpandShortcut" />
            </tk:SettingsCard>

            <InfoBar x:Name="ShortcutWarning" Severity="Warning" IsClosable="True"
                     Title="That shortcut is already in use"
                     Message="Another app (or the island's other shortcut) has claimed it, so the island won't react to it. Try a different one." />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />

            <tk:SettingsCard Header="Preview" Description="How the island looks with the options below."
                             ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                <controls:IslandPreview x:Name="Preview" MaxWidth="560" HorizontalAlignment="Stretch" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Theme" Description="Black like the iPhone, light, or matching Windows. The island restarts to switch.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnTheme">
                    <ComboBoxItem Content="Dark" Tag="" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Match Windows" Tag="System" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Size" Description="How big the island is.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71E;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="SizeBox" MinWidth="160" SelectionChanged="OnSize">
                    <ComboBoxItem Content="Small" Tag="0.85" />
                    <ComboBoxItem Content="Normal" Tag="1.0" />
                    <ComboBoxItem Content="Large" Tag="1.2" />
                    <ComboBoxItem Content="Extra large" Tag="1.4" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Distance from top" Description="Space between the top of the screen and the island.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE76F;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="TopOffset" Width="200" Minimum="0" Maximum="40" StepFrequency="1"
                            ValueChanged="OnTopOffset" VerticalAlignment="Center" />
                    <TextBlock x:Name="TopOffsetLabel" MinWidth="36" VerticalAlignment="Center" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Language" Description="For the island and this app. Both restart to switch.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="OnLanguage">
                    <ComboBoxItem Content="Automatic (Windows language)" Tag="" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Nederlands" Tag="nl" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Show on" Description="Which display the island sits on. It stays below a taskbar at the top of the screen.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DisplayBox" MinWidth="260" SelectionChanged="OnDisplay" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
