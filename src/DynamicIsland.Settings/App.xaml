<Application x:Class="DynamicIsland.SettingsApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout of a settings page, matching the Windows 11 Settings app. -->
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,28,0,20" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6" />
            </Style>
            <Style x:Key="PageStack" TargetType="StackPanel">
                <Setter Property="MaxWidth" Value="1000" />
                <Setter Property="Padding" Value="36,0,36,36" />
                <Setter Property="Spacing" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
