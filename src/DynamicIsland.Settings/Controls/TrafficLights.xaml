<UserControl x:Class="DynamicIsland.SettingsApp.Controls.TrafficLights"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- macOS window controls: close, minimize, zoom. Glyphs appear while the pointer is over the group. -->
    <StackPanel x:Name="Group" Orientation="Horizontal" Spacing="8" Background="Transparent"
                PointerEntered="OnGroupEntered" PointerExited="OnGroupExited" PointerCanceled="OnGroupExited">

        <Grid x:Name="CloseButton" Width="12" Height="12" Tapped="OnClose" PointerPressed="OnPressed" PointerReleased="OnReleased" PointerExited="OnReleased">
            <Ellipse x:Name="CloseDot" StrokeThickness="0.5" />
            <Path x:Name="CloseGlyph" Data="M3.6,3.6 L8.4,8.4 M8.4,3.6 L3.6,8.4" Stroke="#4D0000"
                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
        </Grid>

        <Grid x:Name="MinimizeButton" Width="12" Height="12" Tapped="OnMinimize" PointerPressed="OnPressed" PointerReleased="OnReleased" PointerExited="OnReleased">
            <Ellipse x:Name="MinimizeDot" StrokeThickness="0.5" />
            <Path x:Name="MinimizeGlyph" Data="M3,6 L9,6" Stroke="#985700"
                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
        </Grid>

        <Grid x:Name="ZoomButton" Width="12" Height="12" Tapped="OnZoom" PointerPressed="OnPressed" PointerReleased="OnReleased" PointerExited="OnReleased">
            <Ellipse x:Name="ZoomDot" StrokeThickness="0.5" />
            <Path x:Name="ZoomGlyph" Data="M3.4,3.4 L7.3,3.4 L3.4,7.3 Z M8.6,8.6 L4.7,8.6 L8.6,4.7 Z" Fill="#006500" Opacity="0" />
        </Grid>
    </StackPanel>
</UserControl>
