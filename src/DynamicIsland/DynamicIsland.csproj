<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.5.0</Version>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- x64 by default; publish with -r win-arm64 for Snapdragon PCs (tools/publish-release.ps1 builds both). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU'">x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\island.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicIsland.Tests" />
  </ItemGroup>

  <!-- Claude Code hook scripts ship next to the exe so the settings app can install them. -->
  <ItemGroup>
    <None Include="..\..\tools\claude-hook.ps1;..\..\tools\install-claude-hooks.ps1;..\..\tools\island.ps1" Link="tools\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Publishing the island also publishes the WinUI 3 settings app into a Settings subfolder. -->
  <Target Name="PublishSettingsApp" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\DynamicIsland.Settings\DynamicIsland.Settings.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) -p:Version=$(Version) -o &quot;$([System.IO.Path]::GetFullPath('$(PublishDir)'))Settings&quot;" />
  </Target>

</Project>
