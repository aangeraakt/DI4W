<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <!--
    Per-user installer: no admin rights, installs to %LocalAppData%\Programs\Dynamic Island.
    The in-app updater recognises this install through the registry value below and updates with the next .msi.
  -->
  <Package Name="Dynamic Island for Windows"
           Manufacturer="aangeraakt"
           Version="$(var.AppVersion)"
           UpgradeCode="E513DFD2-80C8-4289-AB9B-6482251656A9"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Dynamic Island is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="island.ico" SourceFile="..\src\DynamicIsland\Assets\island.ico" />
    <Property Id="ARPPRODUCTICON" Value="island.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/aangeraakt/DI4W" />
    <Property Id="ARPHELPLINK" Value="https://github.com/aangeraakt/DI4W/issues" />

    <!-- The app needs the .NET 8 Desktop Runtime; say so up front instead of failing on first start. -->
    <netfx:DotNetCompatibilityCheck Property="DOTNET8DESKTOP" RuntimeType="desktop" Platform="x64" Version="8.0.0" RollForward="minor" />
    <Launch Condition="Installed OR DOTNET8DESKTOP = &quot;0&quot;"
            Message="Dynamic Island needs the .NET 8 Desktop Runtime (x64). Download it from https://dotnet.microsoft.com/download/dotnet/8.0, then run this installer again." />

    <!-- Close a running island and settings app before replacing their files: ask nicely (close and
         end-session messages, which both apps handle by quitting cleanly), and end them after 10 s if still open. -->
    <util:CloseApplication Id="CloseIsland" Target="DynamicIsland.exe" CloseMessage="yes" EndSessionMessage="yes" RebootPrompt="no" Timeout="10" TerminateProcess="1" />
    <util:CloseApplication Id="CloseSettings" Target="DynamicIsland.Settings.exe" CloseMessage="yes" EndSessionMessage="yes" RebootPrompt="no" Timeout="10" TerminateProcess="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Dynamic Island" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Everything from the published app folder (island, Settings\, tools\). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Integration">
      <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="5C7A8E0B-2C2D-4F4B-9D7E-1B0E7C1F3A11">
        <Shortcut Id="IslandShortcut" Name="Dynamic Island" Target="[INSTALLFOLDER]DynamicIsland.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="island.ico" />
        <Shortcut Id="SettingsShortcut" Name="Dynamic Island Settings" Target="[INSTALLFOLDER]Settings\DynamicIsland.Settings.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="island.ico" />
        <!-- Marks this copy as installed by the installer, so the updater uses the next .msi. -->
        <RegistryValue Root="HKCU" Key="Software\DynamicIsland4Windows" Name="InstallFolder" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
        <!-- Remove the whole folder on uninstall, including anything the app or updater added later. -->
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDERPATH" />
      </Component>

      <!-- Start with Windows (can be turned off in the settings app). -->
      <Component Id="Autostart" Directory="INSTALLFOLDER" Guid="0B5E4F9C-6A1E-4E33-8C2B-7F2D9A4C5E21">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="DynamicIsland" Type="string"
                       Value="&quot;[INSTALLFOLDER]DynamicIsland.exe&quot;" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <SetProperty Id="INSTALLFOLDERPATH" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />

    <Feature Id="Main" Title="Dynamic Island">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Integration" />
    </Feature>

    <!-- Minimal wizard: licence, install, and an option to start the island at the end. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Dynamic Island" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]DynamicIsland.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="StartIsland" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartIsland"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
